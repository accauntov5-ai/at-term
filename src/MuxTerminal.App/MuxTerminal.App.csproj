<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8: работает на Windows 7 SP1 и новее, отдельная установка .NET не нужна на Windows 10/11. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MuxTerminal.App</RootNamespace>
    <AssemblyName>MuxTerminal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release: без .pdb — в выходной папке остаётся MuxTerminal.exe (+ необязательный .exe.config). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- Costura + Fody: все DLL встраиваются в MuxTerminal.exe (см. FodyWeavers.xml) -->
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="Fody" Version="6.9.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <!-- Стандартный диалог выбора цвета Windows -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Using Remove="System.Net.Http" />
    <Compile Include="..\MuxTerminal.Core\Polyfills\IsExternalInit.cs" Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuxTerminal.Core\MuxTerminal.Core.csproj" />
  </ItemGroup>

</Project>
