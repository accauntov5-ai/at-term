<Window x:Class="MuxTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="GSM 07.10 MUX Terminal" Icon="Assets/app.ico" Height="780" Width="1280" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Сохранить содержимое вкладки…" Click="SaveLog_Click" />
                <Separator />
                <MenuItem x:Name="SessionLogMenu" Header="Записывать журнал сеанса" IsCheckable="True" Click="SessionLogMenu_Click"
                          ToolTip="Каждый сеанс — в отдельный файл в папке журналов" />
                <MenuItem x:Name="RawFramesLogMenu" Header="…включая сырые MUX-кадры" IsCheckable="True" Click="SessionLogMenu_Click" />
                <MenuItem Header="Открыть папку журналов" Click="OpenLogs_Click" />
                <MenuItem Header="Открыть журнал ошибок (crash.log)" Click="OpenCrashLog_Click" />
                <Separator />
                <MenuItem Header="Выход" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="Отображение и подсветка…" Click="DisplaySettings_Click" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="Показать копилку" Click="ShowCollector_Click" />
                <Separator />
                <MenuItem Header="Переименовать вкладку канала…" Click="RenameTab_Click" InputGestureText="F2" />
            </MenuItem>
            <MenuItem Header="_Окна" SubmenuOpened="WindowsMenu_SubmenuOpened">
                <MenuItem Header="Вынести в отдельное окно" Click="LayoutMenu_Click" Tag="float" InputGestureText="Ctrl+Shift+O" />
                <MenuItem Header="Вернуть во вкладку" Click="LayoutMenu_Click" Tag="dock" InputGestureText="Ctrl+Shift+T" />
                <Separator />
                <MenuItem Header="Разделить: новая группа справа" Click="LayoutMenu_Click" Tag="splitV" />
                <MenuItem Header="Разделить: новая группа снизу" Click="LayoutMenu_Click" Tag="splitH" />
                <MenuItem Header="Переместить в следующую группу" Click="LayoutMenu_Click" Tag="next" />
                <Separator />
                <MenuItem Header="Собрать все окна во вкладки" Click="ResetLayout_Click" />
                <MenuItem Header="Раскладка: лог слева, каналы справа" Click="PresetLayout_Click" />
                <Separator />
                <MenuItem x:Name="ShowWindowMenu" Header="Перейти к вкладке" />
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="О программе" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Панель подключения -->
        <Border DockPanel.Dock="Top" Background="#FFEEF1F5" BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1" Padding="4,6">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                    <TextBlock Style="{StaticResource Label}" Text="Профиль:" Margin="4,0,4,0" />
                    <ComboBox x:Name="ProfileCombo" Width="140" SelectionChanged="ProfileCombo_SelectionChanged"
                              ToolTip="Сохранённые параметры подключения для разных модемов" />
                    <Button Content="Сохранить" Padding="6,0" Margin="2,0,0,0" Click="SaveProfile_Click" ToolTip="Сохранить текущие параметры как профиль" />
                    <Button Content="Удалить" Padding="6,0" Margin="2,0,0,0" Click="DeleteProfile_Click" ToolTip="Удалить выбранный профиль" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Label}" Text="Порт:" Margin="4,0,4,0" />
                    <ComboBox x:Name="PortCombo" Width="150" IsEditable="True" />
                    <Button Content="Обновить" Padding="6,0" Margin="2,0,0,0" Click="RefreshPorts_Click" ToolTip="Обновить список портов" />
                    <TextBlock Style="{StaticResource Label}" Text="Скорость:" />
                    <ComboBox x:Name="BaudCombo" Width="90" IsEditable="True" />
                    <CheckBox x:Name="RtsCtsCheck" Content="RTS/CTS" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Аппаратное управление потоком" />
                    <CheckBox x:Name="DtrCheck" Content="DTR" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="True" ToolTip="Большинству модемов нужен активный DTR" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Label}" Text="Команда:" />
                    <ComboBox x:Name="CmuxCombo" Width="230" IsEditable="True"
                              ToolTip="AT+CMUX=&lt;mode&gt;,&lt;subset&gt;,&lt;port_speed&gt;,&lt;N1&gt;,&lt;T1&gt;,&lt;N2&gt;,&lt;T2&gt;,&lt;T3&gt;,&lt;k&gt;. Поддерживается mode=0 (Basic). N1 берётся из команды (по умолчанию 31).">
                        <ComboBoxItem Content="AT+CMUX=0" />
                        <ComboBoxItem Content="AT+CMUX=0,0,5,127,10,3,30,10,2" />
                        <ComboBoxItem Content="AT+CMUX=0,0,5,31,10,3,30,10,2" />
                    </ComboBox>
                    <CheckBox x:Name="SkipCmuxCheck" Content="Модем уже в MUX" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Не отправлять AT+CMUX, сразу открывать DLC0" />
                    <TextBlock Style="{StaticResource Label}" Text="Каналы:" />
                    <TextBox x:Name="ChannelsBox" Width="70" VerticalContentAlignment="Center" ToolTip="Номера DLC через запятую (1..61)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,2,0,2">
                    <Button x:Name="OpenPortButton" Content="Открыть порт" Padding="10,3" Click="OpenPort_Click"
                            ToolTip="Открыть порт без MUX: обычный AT-терминал на вкладке «COM-порт»" />
                    <Button x:Name="ClosePortButton" Content="Закрыть порт" Padding="10,3" Margin="4,0,12,0" Click="ClosePort_Click" IsEnabled="False"
                            ToolTip="Закрыть MUX (если запущен) и порт" />
                    <Button x:Name="StartButton" Content="Старт MUX" Padding="12,3" Click="Start_Click" FontWeight="SemiBold"
                            ToolTip="Перевести модем в MUX и открыть каналы (порт откроется сам, если закрыт)" />
                    <Button x:Name="StopButton" Content="Стоп MUX" Padding="12,3" Margin="6,0,0,0" Click="Stop_Click" IsEnabled="False"
                            ToolTip="Закрыть MUX; порт остаётся открытым, модем — в AT-режиме" />
                    <CheckBox x:Name="AutoReconnectCheck" Content="Переподключаться" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Если связь с модемом потеряна (порт пропал, модем перезагрузился) — подключаться снова каждые 5 секунд" />
                    <TextBlock Style="{StaticResource Label}" Text="DLC:" Margin="16,0,4,0" />
                    <TextBox x:Name="ExtraDlcBox" Width="34" Text="4" VerticalContentAlignment="Center" />
                    <Button x:Name="AddChannelButton" Content="+ Открыть канал" Padding="8,3" Margin="4,0,0,0" Click="AddChannel_Click" IsEnabled="False"
                            ToolTip="Открыть дополнительный канал в работающем мультиплексоре" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SessionDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0" />
                    <TextBlock x:Name="SessionStateText" Text="Не подключено" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CountersText" Text="RX: 0  TX: 0  Ошибок: 0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="HintText" Foreground="#FF555555"
                           Text="Вкладки можно перетаскивать: в сторону — разделить, за пределы окна — отдельное окно. ПКМ по заголовку — меню." />
            </StatusBarItem>
        </StatusBar>

        <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True" ActiveContentChanged="Dock_ActiveContentChanged">
            <ad:DockingManager.Theme>
                <adt:Vs2013LightTheme />
            </ad:DockingManager.Theme>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutDocumentPaneGroup>
                        <ad:LayoutDocumentPane />
                    </ad:LayoutDocumentPaneGroup>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
