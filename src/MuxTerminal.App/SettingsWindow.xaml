<Window x:Class="MuxTerminal.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuxTerminal.App"
        Title="Настройки отображения" Icon="Assets/app.ico" Width="1060" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrush" />

        <!-- Ячейка цвета: образец (щелчок — стандартный диалог выбора цвета) + HEX-код -->
        <DataTemplate x:Key="ColorCell">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Button Width="22" Height="18" Click="PickColor_Click" Tag="Color" ToolTip="Выбрать цвет"
                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}" BorderBrush="#FF888888" />
                <TextBox Width="72" Margin="4,0,0,0" VerticalContentAlignment="Center"
                         Text="{Binding Color, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BackgroundCell">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Button Width="22" Height="18" Click="PickColor_Click" Tag="Background" ToolTip="Выбрать цвет фона"
                        Background="{Binding Background, Converter={StaticResource ColorToBrush}}" BorderBrush="#FF888888" />
                <TextBox Width="72" Margin="4,0,0,0" VerticalContentAlignment="Center"
                         Text="{Binding Background, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" ToolTip="Пусто — без фона" />
            </StackPanel>
        </DataTemplate>
        <Style TargetType="CheckBox" x:Key="CellCheck">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сбросить всё по умолчанию" Padding="10,3" Margin="0,0,24,0" Click="ResetAll_Click" />
            <Button Content="Применить" Padding="14,3" Margin="0,0,6,0" Click="Apply_Click" />
            <Button Content="OK" Padding="20,3" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Padding="14,3" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TabControl>
            <TabItem Header="Вид">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Шрифт (моноширинный):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="FontCombo" Grid.Column="1" Width="200" Height="24" />
                        <TextBlock Text="Размер:" Grid.Row="1" VerticalAlignment="Center" />
                        <ComboBox x:Name="SizeCombo" Grid.Row="1" Grid.Column="1" Width="80" Height="24" HorizontalAlignment="Left" IsEditable="True" />
                        <TextBlock Text="Формат даты/времени:" Grid.Row="2" VerticalAlignment="Center" />
                        <ComboBox x:Name="TimeFormatCombo" Grid.Row="2" Grid.Column="1" Width="200" Height="24" IsEditable="True"
                                  ToolTip="Формат .NET: dd.MM.yyyy HH:mm:ss.fff и т.п." />

                        <TextBlock Text="Фон:" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackgroundSwatch" Width="22" Height="18" Click="PickGlobalColor_Click" Tag="Background" BorderBrush="#FF888888" />
                            <TextBox x:Name="BackgroundBox" Width="80" Margin="4,0,0,0" TextChanged="GlobalColorBox_TextChanged" Tag="Background" />
                        </StackPanel>
                        <TextBlock Text="Основной текст:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ForegroundSwatch" Width="22" Height="18" Click="PickGlobalColor_Click" Tag="Foreground" BorderBrush="#FF888888" />
                            <TextBox x:Name="ForegroundBox" Width="80" Margin="4,0,0,0" TextChanged="GlobalColorBox_TextChanged" Tag="Foreground" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Text="Темы:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Тёмная" Padding="8,1" Margin="0,0,4,0" Click="Theme_Click" Tag="dark" />
                            <Button Content="Светлая" Padding="8,1" Margin="0,0,4,0" Click="Theme_Click" Tag="light" />
                            <Button Content="Классическая (зелёная)" Padding="8,1" Click="Theme_Click" Tag="green" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,4"
                               Text="Выделение по типу текста. «Выделять» — применять оформление; «Показывать» — выводить ли вообще (время и системные сообщения терминала можно скрыть)." />
                    <DataGrid x:Name="CategoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="26" SelectionUnit="Cell">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип текста" Binding="{Binding DisplayName}" IsReadOnly="True" Width="180" />
                            <DataGridTemplateColumn Header="Выделять" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Показывать" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Visible, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanHide}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Цвет" Width="110" CellTemplate="{StaticResource ColorCell}" />
                            <DataGridTemplateColumn Header="Фон" Width="110" CellTemplate="{StaticResource BackgroundCell}" />
                            <DataGridTemplateColumn Header="Жирный" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Bold, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Курсив" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Italic, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Шрифт (моноширинный)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2" ItemsSource="{Binding Source={x:Static local:SettingsWindow.CategoryFonts}}"
                                                  SelectedItem="{Binding FontFamily, TargetNullValue={x:Static local:SettingsWindow.DefaultFontLabel}, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Поиск и копилка">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,6"
                               Text="Совпадения подсвечиваются во всех вкладках. Строки с включённым «В копилку» собираются во вкладку «Копилка». Правило выше в списке имеет приоритет. Шаблон — текст или регулярное выражение (^ — начало строки после метки времени)." />
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="130">
                        <Button Content="Добавить" Margin="0,0,0,4" Padding="4,3" Click="AddRule_Click" />
                        <Button Content="Удалить" Margin="0,0,0,4" Padding="4,3" Click="DeleteRule_Click" />
                        <Button Content="Вверх" Margin="0,0,0,4" Padding="4,3" Click="MoveRule_Click" Tag="-1" />
                        <Button Content="Вниз" Margin="0,0,0,16" Padding="4,3" Click="MoveRule_Click" Tag="1" />
                        <Button Content="Правила по умолчанию" Padding="4,3" Click="ResetRules_Click" />
                        <TextBlock Text="Проверка шаблона:" Margin="0,16,0,2" />
                        <TextBox x:Name="TestBox" Text="+CME ERROR: 10" TextChanged="TestBox_TextChanged" />
                        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555" />
                    </StackPanel>
                    <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="26" SelectionMode="Single"
                              CellEditEnding="RuleGrid_CellEditEnding" SelectionChanged="RuleGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Вкл" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Шаблон" Binding="{Binding Pattern}" Width="*" />
                            <DataGridTemplateColumn Header="Regex" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding IsRegex, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aa" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding MatchCase, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Учитывать регистр" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Цвет" Width="110" CellTemplate="{StaticResource ColorCell}" />
                            <DataGridTemplateColumn Header="Фон" Width="110" CellTemplate="{StaticResource BackgroundCell}" />
                            <DataGridTemplateColumn Header="Жирный" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Bold, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="В копилку" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding Collect, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Быстрые команды">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,8"
                               Text="Кнопки над строкой ввода в каждой вкладке канала. Каждая строка — отдельная команда; ^Z — Ctrl+Z (0x1A), \xHH — любой байт, \r \n — перевод строки, «#wait 1000» — пауза в мс. Повторное нажатие кнопки во время выполнения — остановка." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                                <Button Content="Добавить" Margin="0,0,3,3" Padding="4,2" Click="AddMacro_Click" />
                                <Button Content="Удалить" Margin="3,0,0,3" Padding="4,2" Click="DeleteMacro_Click" />
                                <Button Content="Вверх" Margin="0,0,3,3" Padding="4,2" Click="MoveMacro_Click" Tag="-1" />
                                <Button Content="Вниз" Margin="3,0,0,3" Padding="4,2" Click="MoveMacro_Click" Tag="1" />
                                <Button Content="По умолчанию" Margin="0,0,3,0" Padding="4,2" Click="ResetMacros_Click" />
                            </UniformGrid>
                            <ListBox x:Name="MacroList" SelectionChanged="MacroList_SelectionChanged" />
                        </DockPanel>
                        <Grid x:Name="MacroEditor" Grid.Column="2" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox Grid.ColumnSpan="2" Content="Показывать кнопку" IsChecked="{Binding Enabled}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Название:" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox x:Name="MacroNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="MacroName_TextChanged" />
                            <TextBlock Grid.Row="2" Text="Команды:" Margin="0,2,8,0" />
                            <TextBox x:Name="MacroTextBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Пауза между строками, мс:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="60" Text="{Binding DelayMs}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox Content="Ждать ответа модема (OK / ERROR / &gt;) перед следующей строкой, таймаут, мс:"
                                          IsChecked="{Binding WaitForResult}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="60" Text="{Binding TimeoutMs}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
