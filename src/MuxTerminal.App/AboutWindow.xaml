<Window x:Class="MuxTerminal.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Icon="Assets/app.ico" Width="720" Height="600" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Копировать сведения" Padding="10,3" Margin="0,0,6,0" Click="CopyInfo_Click"
                    ToolTip="Версия программы, Windows и .NET — для сообщения о проблеме" />
            <Button Content="Закрыть" Padding="16,3" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app.png" Width="80" Height="80" VerticalAlignment="Top" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="CopyrightText" Margin="0,8,0,0" />
                <TextBlock Margin="0,2,0,0">
                    <Hyperlink x:Name="RepoLink" Click="RepoLink_Click"><Run x:Name="RepoText" /></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="SystemText" Margin="0,8,0,0" Foreground="#FF555555" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="Возможности">
                <TextBox x:Name="FeaturesBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="6"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Лицензия (MIT)">
                <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="6"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Сторонние компоненты">
                <TextBox x:Name="NoticesBox" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Padding="6"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
