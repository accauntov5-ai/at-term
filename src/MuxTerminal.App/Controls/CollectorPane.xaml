<UserControl x:Class="MuxTerminal.App.Controls.CollectorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FFD0D0D0" Background="#FFF5F6F7" Padding="4,3">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Style="{StaticResource ToolButton}" Content="Очистить" Click="Clear_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="Сохранить…" Click="Save_Click" />
                    <TextBlock Text="Правило:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox x:Name="RuleFilter" Width="170" SelectionChanged="RuleFilter_SelectionChanged" />
                    <CheckBox x:Name="AutoScrollCheck" Content="Автопрокрутка" IsChecked="True" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBlock x:Name="CountText" Text="Записей: 0" VerticalAlignment="Center" Margin="8,0" Foreground="#FF555555" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="В окно" Click="Layout_Click" Tag="float" ToolTip="Вынести в отдельное окно" />
                    <Button Style="{StaticResource ToolButton}" Content="Во вкладку" Click="Layout_Click" Tag="dock" ToolTip="Вернуть во вкладку главного окна" />
                    <Button Style="{StaticResource ToolButton}" Content="Справа" Click="Layout_Click" Tag="splitV" ToolTip="Разделить окно: в новую группу справа" />
                    <Button Style="{StaticResource ToolButton}" Content="Снизу" Click="Layout_Click" Tag="splitH" ToolTip="Разделить окно: в новую группу снизу" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <ListView x:Name="List" Grid.Row="1" BorderThickness="0" SelectionMode="Extended"
                  MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ToolTip="Двойной щелчок — перейти к вкладке-источнику. Ctrl+C — копировать выделенные строки.">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать" Click="Copy_Click" InputGestureText="Ctrl+C" />
                    <MenuItem Header="Перейти к вкладке" Click="Navigate_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{Binding Brush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Время" Width="150" DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Header="Источник" Width="140" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="Правило" Width="150" DisplayMemberBinding="{Binding RuleName}" />
                    <GridViewColumn Header="Строка" Width="700" DisplayMemberBinding="{Binding Line}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
