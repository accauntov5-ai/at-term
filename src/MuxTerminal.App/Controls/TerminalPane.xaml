<UserControl x:Class="MuxTerminal.App.Controls.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="24" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель инструментов вкладки -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FFD0D0D0" Background="#FFF5F6F7" Padding="4,3">
            <!-- WrapPanel: на узком (вынесенном/разделённом) окне кнопки переносятся на вторую строку -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Border x:Name="StatePanel" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Background="#FFE0E0E0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="Gray" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Text="закрыт" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="OpenChannelButton" Style="{StaticResource ToolButton}" Content="Открыть" Click="OpenChannel_Click"
                            ToolTip="Открыть канал (SABM)" />
                    <Button x:Name="CloseChannelButton" Style="{StaticResource ToolButton}" Content="Закрыть" Click="CloseChannel_Click"
                            ToolTip="Закрыть канал (DISC)" />
                    <Button Style="{StaticResource ToolButton}" Content="Очистить" Click="Clear_Click" ToolTip="Очистить экран" />
                    <Border Width="1" Background="#FFC8C8C8" Margin="4,2" />
                    <RadioButton x:Name="TextModeRadio" Content="Текст"
                                 IsChecked="True" VerticalAlignment="Center" Margin="4,0" Checked="ViewMode_Changed" />
                    <RadioButton x:Name="HexModeRadio" Content="HEX"
                                 VerticalAlignment="Center" Margin="4,0" Checked="ViewMode_Changed" />
                    <CheckBox x:Name="AutoScrollCheck" Content="Автопрокрутка" IsChecked="True" />
                    <CheckBox x:Name="TimestampCheck" Content="Время" Checked="ViewMode_Changed" Unchecked="ViewMode_Changed" />
                    <CheckBox x:Name="EchoCheck" Content="Локальное эхо" Checked="ViewMode_Changed" Unchecked="ViewMode_Changed"
                              ToolTip="Показывать отправленные данные (если эхо модема выключено, ATE0)" />
                    <CheckBox x:Name="DataFramesCheck" Content="Кадры данных" IsChecked="True" Visibility="Collapsed"
                              Checked="ViewMode_Changed" Unchecked="ViewMode_Changed"
                              ToolTip="Показывать UIH-кадры каналов 1..63. Снимите, чтобы видеть только служебный обмен (SABM/UA/DISC, DLC0, ошибки)" />
                    <CheckBox x:Name="WrapCheck" Content="Перенос" IsChecked="True" Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="В окно" Click="Layout_Click" Tag="float" ToolTip="Вынести в отдельное окно (Ctrl+Shift+O)" />
                    <Button Style="{StaticResource ToolButton}" Content="Во вкладку" Click="Layout_Click" Tag="dock" ToolTip="Вернуть во вкладку главного окна (Ctrl+Shift+T)" />
                    <Button Style="{StaticResource ToolButton}" Content="Справа" Click="Layout_Click" Tag="splitV" ToolTip="Разделить окно: перенести вкладку в новую группу справа" />
                    <Button Style="{StaticResource ToolButton}" Content="Снизу" Click="Layout_Click" Tag="splitH" ToolTip="Разделить окно: перенести вкладку в новую группу снизу" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Вывод: AvalonEdit — быстрый вывод больших объёмов с раскраской по категориям и правилам.
             Независимый скроллбар у каждой вкладки, Ctrl+F — поиск по тексту. -->
        <ae:TextEditor x:Name="Output" Grid.Row="1"
                       IsReadOnly="True" WordWrap="True" ShowLineNumbers="False"
                       FontSize="13" Padding="4"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Background="#FF1E1E1E" Foreground="#FFDCDCDC" />

        <!-- Ввод команд -->
        <Border x:Name="InputPanel" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#FFD0D0D0" Background="#FFF5F6F7" Padding="4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ComboBox x:Name="LineEndingCombo" Width="80" Margin="4,0" SelectedIndex="0" ToolTip="Окончание строки при отправке">
                        <ComboBoxItem Content="CR" Tag="&#13;" />
                        <ComboBoxItem Content="CR+LF" Tag="&#13;&#10;" />
                        <ComboBoxItem Content="LF" Tag="&#10;" />
                        <ComboBoxItem Content="нет" Tag="" />
                    </ComboBox>
                    <CheckBox x:Name="HexInputCheck" Content="HEX-ввод" ToolTip="Вводить байты в HEX: 41 54 0D" />
                    <Button Style="{StaticResource ToolButton}" Content="Ctrl+Z" Click="CtrlZ_Click" ToolTip="Отправить текст из строки ввода и 0x1A — завершение SMS после AT+CMGS" />
                    <Button Style="{StaticResource ToolButton}" Content="Esc" Click="Esc_Click" ToolTip="Отправить 0x1B — отмена ввода SMS" />
                    <Button x:Name="SendButton" Content="Отправить" Padding="12,2" Click="Send_Click" IsDefault="False" />
                </StackPanel>
                <TextBox x:Name="Input" FontSize="13" VerticalContentAlignment="Center"
                         PreviewKeyDown="Input_PreviewKeyDown" ToolTip="Enter — отправить, стрелки вверх/вниз — история команд, Ctrl+Z — отправить текст и 0x1A (SMS)" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
